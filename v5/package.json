{
  "name": "biotrack-ai-v5",
  "private": true,
  "version": "5.0.0-alpha.1",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/exercise-media.mjs generate",
    "dev": "vite",
    "prebuild": "node scripts/exercise-media.mjs generate",
    "build": "node scripts/app-icon.mjs prepare && tsc -b && vite build && node scripts/service-worker.mjs && node scripts/exercise-media.mjs verify-dist",
    "postbuild": "node scripts/app-icon.mjs cleanup",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "media:generate": "node scripts/exercise-media.mjs generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.2",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
