{
  "name": "biotrack-ai-v5",
  "private": true,
  "version": "5.0.0-alpha.1",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/exercise-media.mjs generate",
    "dev": "vite",
    "prebuild": "node scripts/exercise-media.mjs generate",
    "build": "node scripts/app-icon.mjs prepare && tsc -b && vite build && node scripts/exercise-media.mjs verify-dist",
    "postbuild": "node scripts/app-icon.mjs cleanup",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "media:generate": "node scripts/exercise-media.mjs generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.2",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
